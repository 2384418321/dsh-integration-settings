{
  "name": "dsh-integration-settings",
  "version": "0.2.6",
  "type": "module",
  "description": "集成插件：在 DSH 设置中加入「MCP 管理 / Skill 管理 / 全局人设 / 思考解锁」四个可视化页面——思考解锁会自动识别各网关真正支持的思考档位，一键或定时写回配置",
  "license": "MIT",
  "author": "2384418321 (https://github.com/2384418321)",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mcp",
    "skills",
    "agents-md",
    "settings"
  ],
  "homepage": "https://github.com/2384418321/dsh-integration-settings#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2384418321/dsh-integration-settings.git"
  },
  "bugs": {
    "url": "https://github.com/2384418321/dsh-integration-settings/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react-dom": "18.3.1",
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <4.1.0-0 || >=4.1.0-rc.1 <5",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-web-app": ">=0.1.2-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-web-app": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
